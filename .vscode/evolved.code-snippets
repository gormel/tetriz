{
  "system": {
    "scope": "lua",
    "prefix": "syst",
    "body": [
        "local evolved = require \"lib.evolved\"",
        "local cfg = require \"cfg.cfg\"",
        "local utils = require \"cfg.utils\"",
        "local cmp = require \"ecs.features.${2:feature}.components\"",
        "",
        "local filter = evolved.builder()",
        "\t:include(${0})",
        "",
        "local function update(chunk, ety_list, ety_c, dt)",
        "\t",
        "end",
        "",
        "return {",
        "\tname = \"${1:system_name}\",",
        "\tfilter = filter:execute(update):build(),",
        "}"
    ]
  },
  "for_filter":{
    "scope": "lua",
    "prefix": "forf",
    "body": [
      "for i = ety_c, 1, -1 do",
      "\tlocal entity = ety_list[i]",
      "\t${0}",
      "end"
    ]
  },
  "require":{
    "scope": "lua",
    "prefix": "rcmp",
    "body": [ "local ${1} = require \"ecs.features.${0}.components\"" ]
  }
}